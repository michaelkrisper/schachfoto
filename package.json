{
  "name": "schachfoto",
  "version": "1.0.0",
  "private": true,
  "description": "Photograph a chess board, recognise the position and see the best moves. PWA on Cloudflare Pages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelkrisper/schachfoto.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --port 8793",
    "deploy": "wrangler pages deploy public --project-name schachfoto --branch main",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "node --test 'tests/*.test.js'",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=24"
  }
}
